{
  "name": "containerbase-erlang-prebuild",
  "private": true,
  "license": "MIT",
  "author": "Michael Kriese <michael.kriese@visualon.de>",
  "repository": "https://github.com/containerbase/erlang-prebuild.git",
  "type": "module",
  "scripts": {
    "lint": "run-s oxfmt lint:markdown",
    "lint:markdown": "markdownlint-cli2 '**/*.md'",
    "lint-fix:markdown": "markdownlint-cli2 --fix '**/*.md'",
    "prepare": "husky",
    "oxfmt": "oxfmt --check",
    "oxfmt-fix": "oxfmt"
  },
  "devDependencies": {
    "husky": "9.1.7",
    "lint-staged": "17.6.2",
    "markdownlint-cli2": "0.24.2",
    "npm-run-all2": "9.1.0",
    "oxfmt": "0.80.0"
  },
  "engines": {
    "node": "^22.11.0 || >=24.11.0",
    "pnpm": "^12.0.0"
  },
  "packageManager": "pnpm@12.23.0"
}
